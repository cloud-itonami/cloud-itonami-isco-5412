(ns precinctops.governor-test
  (:require [kotoba.test :refer [deftest is testing]]
            [precinctops.store :as store]
            [precinctops.advisor :as advisor]
            [precinctops.governor :as governor]))

(defn- fresh-store []
  (let [st (store/mem-store)]
    (store/register-officer! st {:officer-id "O-1" :name "Ofc. Delgado"
                                 :precinct-id "precinct-9" :verified? true})
    (store/register-equipment! st {:equipment-id "E-1" :precinct-id "precinct-9"
                                   :max-supply-cost 500 :verified? true})
    st))

(defn- log-op []
  {:op :log-equipment-record :effect :propose :officer-id "O-1" :equipment-id "E-1"
   :condition :good :mileage 45210 :inspected-by "Ofc. Delgado" :timestamp "2026-07-14T10:00:00Z"
   :stake :low :confidence 0.9
   :rationale "documented log-equipment-record for equipment E-1"})

(defn- patrol-op []
  {:op :schedule-patrol-operation :effect :propose :officer-id "O-1" :equipment-id "E-1"
   :shift-start "2026-07-20T09:00:00Z" :shift-end "2026-07-20T17:00:00Z" :route "beat-12"
   :stake :low :confidence 0.9
   :rationale "documented schedule-patrol-operation for equipment E-1"})

(defn- flag-op
  ([] (flag-op nil))
  ([equipment-id]
   {:op :flag-precinct-concern :effect :propose :officer-id "O-1" :equipment-id equipment-id
    :reason :equipment-maintenance :note "vehicle brakes need inspection" :stake :low :confidence 0.9
    :rationale "documented flag-precinct-concern (no equipment reference — precinct-level concern)"}))

(defn- supply-op [cost]
  {:op :coordinate-supply-order :effect :propose :officer-id "O-1" :equipment-id "E-1"
   :item "replacement tires" :cost cost :vendor "FleetSupplyCo" :category :vehicle-parts
   :stake :low :confidence 0.9
   :rationale "documented coordinate-supply-order for equipment E-1"})

(def ^:private req {})

;; --- happy path -----------------------------------------------------

(deftest ok-well-formed-log-entry
  (let [st (fresh-store)
        v (governor/check req {} (log-op) st)]
    (is (:ok? v))
    (is (not (:hard? v)))
    (is (not (:escalate? v)))))

(deftest ok-well-formed-patrol-scheduling
  (let [st (fresh-store)
        v (governor/check req {} (patrol-op) st)]
    (is (:ok? v))))

(deftest ok-at-or-below-threshold-supply-order
  (let [st (fresh-store)
        v (governor/check req {} (supply-op 250) st)]
    (is (:ok? v))))

(deftest ok-at-exact-supply-cost-threshold-boundary
  (testing "the supply-cost escalation threshold is inclusive (exactly-at-threshold does not escalate)"
    (let [st (fresh-store)
          v (governor/check req {} (supply-op governor/supply-cost-escalation-threshold) st)]
      (is (:ok? v))
      (is (not (:escalate? v))))))

;; --- officer provenance ----------------------------------------------

(deftest hard-on-unregistered-officer
  (let [st (fresh-store)
        v (governor/check req {} (assoc (log-op) :officer-id "ghost") st)]
    (is (:hard? v))
    (is (some #(= :unknown-officer (:rule %)) (:violations v)))))

(deftest hard-on-unverified-officer
  (let [st (fresh-store)]
    (store/register-officer! st {:officer-id "O-2" :name "Unverified"
                                 :precinct-id "precinct-9" :verified? false})
    (let [v (governor/check req {} (assoc (log-op) :officer-id "O-2") st)]
      (is (:hard? v))
      (is (some #(= :officer-unverified (:rule %)) (:violations v))))))

;; --- equipment provenance ---------------------------------------------

(deftest hard-on-missing-equipment-id
  (let [st (fresh-store)
        v (governor/check req {} (assoc (log-op) :equipment-id nil) st)]
    (is (:hard? v))
    (is (some #(= :missing-equipment-id (:rule %)) (:violations v)))))

(deftest hard-on-unknown-equipment
  (let [st (fresh-store)
        v (governor/check req {} (assoc (log-op) :equipment-id "E-ghost") st)]
    (is (:hard? v))
    (is (some #(= :unknown-equipment (:rule %)) (:violations v)))))

(deftest hard-on-unverified-equipment
  (let [st (fresh-store)]
    (store/register-equipment! st {:equipment-id "E-2" :precinct-id "precinct-9"
                                   :max-supply-cost 500 :verified? false})
    (let [v (governor/check req {} (assoc (log-op) :equipment-id "E-2") st)]
      (is (:hard? v))
      (is (some #(= :equipment-unverified (:rule %)) (:violations v))))))

(deftest hard-on-equipment-wrong-precinct
  (let [st (fresh-store)]
    (store/register-equipment! st {:equipment-id "E-3" :precinct-id "precinct-1"
                                   :max-supply-cost 500 :verified? true})
    (let [v (governor/check req {} (assoc (log-op) :equipment-id "E-3") st)]
      (is (:hard? v))
      (is (some #(= :equipment-wrong-precinct (:rule %)) (:violations v))))))

(deftest flag-precinct-concern-does-not-require-existing-equipment
  (testing "flag-precinct-concern is the channel by which any administrative/equipment/training concern is surfaced for human intake"
    (let [st (fresh-store)
          v (governor/check req {} (flag-op nil) st)]
      (is (not (:hard? v)))
      (is (:escalate? v)))))

;; --- no-actuation / closed allowlist ----------------------------------

(deftest hard-on-no-actuation-violation
  (let [st (fresh-store)
        v (governor/check req {} (assoc (log-op) :effect :direct-write) st)]
    (is (:hard? v))
    (is (some #(= :no-actuation (:rule %)) (:violations v)))))

(deftest hard-on-op-not-allowed-use-force
  (testing "no path through this actor can use force — no such op exists in the allowlist to begin with;
            this asserts the governor also rejects one forged onto a proposal"
    (let [st (fresh-store)
          v (governor/check req {} (assoc (log-op) :op :use-force) st)]
      (is (:hard? v))
      (is (some #(= :op-not-allowed (:rule %)) (:violations v))))))

(deftest hard-on-op-not-allowed-deploy-weapon
  (let [st (fresh-store)
        v (governor/check req {} (assoc (log-op) :op :deploy-weapon) st)]
    (is (:hard? v))
    (is (some #(= :op-not-allowed (:rule %)) (:violations v)))))

(deftest hard-on-op-not-allowed-make-arrest
  (let [st (fresh-store)
        v (governor/check req {} (assoc (log-op) :op :make-arrest) st)]
    (is (:hard? v))
    (is (some #(= :op-not-allowed (:rule %)) (:violations v)))))

(deftest hard-on-op-not-allowed-detain-suspect
  (let [st (fresh-store)
        v (governor/check req {} (assoc (log-op) :op :detain-suspect) st)]
    (is (:hard? v))
    (is (some #(= :op-not-allowed (:rule %)) (:violations v)))))

(deftest hard-on-op-not-allowed-authorize-search
  (let [st (fresh-store)
        v (governor/check req {} (assoc (log-op) :op :authorize-search) st)]
    (is (:hard? v))
    (is (some #(= :op-not-allowed (:rule %)) (:violations v)))))

(deftest hard-on-op-not-allowed-pursue-suspect
  (let [st (fresh-store)
        v (governor/check req {} (assoc (log-op) :op :pursue-suspect) st)]
    (is (:hard? v))
    (is (some #(= :op-not-allowed (:rule %)) (:violations v)))))

(deftest every-scope-excluded-op-name-is-rejected
  (testing "every explicitly named scope-excluded op fixture (use-of-force, weapon-deployment, arrest, detention,
            search/seizure authorization, pursuit/engagement) is a hard, permanent block"
    (let [st (fresh-store)]
      (doseq [op governor/scope-excluded-ops]
        (let [v (governor/check req {} (assoc (log-op) :op op) st)]
          (is (:hard? v) (str "op " op " was not hard-blocked"))
          (is (some #(= :op-not-allowed (:rule %)) (:violations v))
              (str "op " op " did not trip :op-not-allowed")))))))

;; --- tactical-assessment / tactical-dispatch forbidden -------

(deftest hard-on-tactical-assessment-forbidden
  (testing "log-equipment-record is equipment condition metadata only — tactical/incident assessment is forbidden"
    (let [st (fresh-store)
          v (governor/check req {} (assoc (log-op) :threat-level :elevated) st)]
      (is (:hard? v))
      (is (some #(= :tactical-assessment-forbidden (:rule %)) (:violations v))))))

(deftest hard-on-tactical-assessment-forbidden-suspect-location-key
  (let [st (fresh-store)
        v (governor/check req {} (assoc (log-op) :suspect-location "5th & Main") st)]
    (is (:hard? v))
    (is (some #(= :tactical-assessment-forbidden (:rule %)) (:violations v)))))

(deftest hard-on-tactical-dispatch-forbidden
  (testing "schedule-patrol-operation never carries a real-time tactical dispatch during an active incident"
    (let [st (fresh-store)
          v (governor/check req {} (assoc (patrol-op) :active-incident-id "INC-42") st)]
      (is (:hard? v))
      (is (some #(= :tactical-dispatch-forbidden (:rule %)) (:violations v))))))

(deftest hard-on-tactical-dispatch-forbidden-pursuit-authorization-key
  (let [st (fresh-store)
        v (governor/check req {} (assoc (patrol-op) :pursuit-authorization true) st)]
    (is (:hard? v))
    (is (some #(= :tactical-dispatch-forbidden (:rule %)) (:violations v)))))

;; --- weapon-procurement forbidden (dedicated hard block) ---------------

(deftest hard-on-weapon-procurement-firearm
  (testing "a supply order naming a firearm is a hard, permanent block regardless of cost"
    (let [st (fresh-store)
          v (governor/check req {} (assoc (supply-op 10) :item "9mm service pistol") st)]
      (is (:hard? v))
      (is (some #(= :weapon-procurement-forbidden (:rule %)) (:violations v))))))

(deftest hard-on-weapon-procurement-ammunition
  (let [st (fresh-store)
        v (governor/check req {} (assoc (supply-op 10) :item "ammunition resupply") st)]
    (is (:hard? v))
    (is (some #(= :weapon-procurement-forbidden (:rule %)) (:violations v)))))

(deftest hard-on-weapon-procurement-taser
  (let [st (fresh-store)
        v (governor/check req {} (assoc (supply-op 10) :item "conducted energy weapon cartridges") st)]
    (is (:hard? v))
    (is (some #(= :weapon-procurement-forbidden (:rule %)) (:violations v)))))

(deftest hard-on-weapon-procurement-baton
  (let [st (fresh-store)
        v (governor/check req {} (assoc (supply-op 10) :item "expandable baton") st)]
    (is (:hard? v))
    (is (some #(= :weapon-procurement-forbidden (:rule %)) (:violations v)))))

(deftest hard-on-weapon-procurement-via-category
  (testing "the weapon check also inspects :category, not just :item"
    (let [st (fresh-store)
          v (governor/check req {} (assoc (supply-op 10) :item "restock" :category "less-lethal launcher") st)]
      (is (:hard? v))
      (is (some #(= :weapon-procurement-forbidden (:rule %)) (:violations v))))))

(deftest ok-non-weapon-protective-gear-supply-order
  (testing "protective gear, vehicles, and radios remain allowed non-weapon equipment"
    (let [st (fresh-store)
          v (governor/check req {} (assoc (supply-op 200) :item "reflective safety vest" :category :protective-gear) st)]
      (is (:ok? v)))))

;; --- scope-excluded rationale (defense-in-depth) -----------------------

(deftest hard-on-scope-excluded-force-rationale
  (testing "a proposal on an otherwise-allowed op whose rationale names a finalization action for using force
            is a permanent HARD block, independent of the op-allowlist check"
    (let [st (fresh-store)
          v (governor/check req {} (assoc (log-op) :rationale "logged the equipment in order to use force") st)]
      (is (:hard? v))
      (is (some #(= :scope-excluded (:rule %)) (:violations v))))))

(deftest hard-on-scope-excluded-weapon-rationale
  (let [st (fresh-store)
        v (governor/check req {} (assoc (log-op) :rationale "logged the item to deploy the weapon") st)]
    (is (:hard? v))
    (is (some #(= :scope-excluded (:rule %)) (:violations v)))))

(deftest hard-on-scope-excluded-arrest-rationale
  (let [st (fresh-store)
        v (governor/check req {} (assoc (log-op) :rationale "logged evidence in order to make the arrest") st)]
    (is (:hard? v))
    (is (some #(= :scope-excluded (:rule %)) (:violations v)))))

(deftest hard-on-scope-excluded-detention-rationale
  (let [st (fresh-store)
        v (governor/check req {} (assoc (log-op) :rationale "logged the record to detain the suspect") st)]
    (is (:hard? v))
    (is (some #(= :scope-excluded (:rule %)) (:violations v)))))

(deftest hard-on-scope-excluded-search-rationale
  (let [st (fresh-store)
        v (governor/check req {} (assoc (log-op) :rationale "filed the record to authorize the search") st)]
    (is (:hard? v))
    (is (some #(= :scope-excluded (:rule %)) (:violations v)))))

(deftest hard-on-scope-excluded-pursuit-rationale
  (let [st (fresh-store)
        v (governor/check req {} (assoc (log-op) :rationale "logged the item to pursue the suspect") st)]
    (is (:hard? v))
    (is (some #(= :scope-excluded (:rule %)) (:violations v)))))

(deftest hard-on-scope-excluded-note-field
  (testing "the scope-exclusion check also inspects :note (used by flag-precinct-concern)"
    (let [st (fresh-store)
          v (governor/check req {} (assoc (flag-op "E-1") :note "recommend we engage the suspect now") st)]
      (is (:hard? v))
      (is (some #(= :scope-excluded (:rule %)) (:violations v))))))

;; --- escalation ---------------------------------------------------------

(deftest always-escalates-flag-precinct-concern-even-at-high-confidence
  (testing "surfacing a precinct/equipment/training concern always requires human review"
    (let [st (fresh-store)
          v (governor/check req {} (assoc (flag-op "E-1") :confidence 0.99) st)]
      (is (not (:hard? v)))
      (is (:escalate? v)))))

(deftest always-escalates-above-threshold-supply-order
  (testing "a non-weapon equipment supply order above the cost threshold always needs human sign-off"
    (let [st (fresh-store)
          v (governor/check req {} (assoc (supply-op (+ governor/supply-cost-escalation-threshold 1))
                                          :confidence 0.99)
                            st)]
      (is (not (:hard? v)))
      (is (:escalate? v)))))

(deftest escalates-low-confidence
  (let [st (fresh-store)
        v (governor/check req {} (assoc (log-op) :confidence 0.3) st)]
    (is (not (:hard? v)))
    (is (:escalate? v))))

;; --- fleet-known self-trip regression -----------------------------------

(deftest default-mock-advisor-proposals-never-self-trip-scope-exclusion
  (testing "the default mock advisor's own rationale text for every op in the closed allowlist never contains
            a scope-excluded finalization/execution phrase for a use-of-force decision, weapon deployment, arrest,
            detention, search/seizure authorization, or pursuit/engagement of a suspect (fleet-known self-trip bug
            class regression)"
    (let [st (fresh-store)
          adv (advisor/mock-advisor)
          requests [{:op :log-equipment-record :officer-id "O-1" :equipment-id "E-1" :stake :low
                     :condition :good :mileage 45210 :inspected-by "Ofc. Delgado" :timestamp "2026-07-14T10:00:00Z"}
                    {:op :schedule-patrol-operation :officer-id "O-1" :equipment-id "E-1" :stake :low
                     :shift-start "2026-07-20T09:00:00Z" :shift-end "2026-07-20T17:00:00Z" :route "beat-12"}
                    {:op :flag-precinct-concern :officer-id "O-1" :equipment-id "E-1" :stake :low
                     :reason :equipment-maintenance :note "vehicle brakes need inspection"}
                    {:op :flag-precinct-concern :officer-id "O-1" :equipment-id nil :stake :low
                     :reason :training-gap :note "in-service training overdue for shift B"}
                    {:op :coordinate-supply-order :officer-id "O-1" :equipment-id "E-1" :stake :low
                     :item "replacement tires" :cost 220 :vendor "FleetSupplyCo" :category :vehicle-parts}]]
      (doseq [req' requests]
        (let [proposal (advisor/-advise adv st req')]
          (is (false? (governor/out-of-scope? proposal))
              (str "op " (:op req') " self-tripped scope-exclusion: " (:rationale proposal)))
          (is (false? (governor/weapon-item? proposal))
              (str "op " (:op req') " self-tripped weapon-item?: " (:item proposal)))
          (let [v (governor/check {} {} proposal st)]
            (is (not (contains? (set (map :rule (:violations v))) :scope-excluded))
                (str "op " (:op req') " tripped :scope-excluded in governor/check"))
            (is (not (contains? (set (map :rule (:violations v))) :op-not-allowed))
                (str "op " (:op req') " tripped :op-not-allowed in governor/check"))
            (is (not (contains? (set (map :rule (:violations v))) :weapon-procurement-forbidden))
                (str "op " (:op req') " tripped :weapon-procurement-forbidden in governor/check"))))))))
